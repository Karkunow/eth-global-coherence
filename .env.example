# Cohesion — environment template
#
#   cp .env.example .env      then fill in the real values
#
# .env is gitignored; this template is committed. Never put real keys in here.
# The repo goes public for judging — a key committed once is a key to rotate.

# ─────────────────────────────────────────────────────────────────────────────
# The Graph — live Uniswap v3 pool data (defines the probe triangle)
# ─────────────────────────────────────────────────────────────────────────────
# Self-serve, instant: https://thegraph.com/studio/apikeys/
# Free tier is 100k queries/month — far more than a demo needs.
GRAPH_API_KEY=

# Uniswap v3 mainnet subgraph. The key goes in the URL PATH, not a header.
GRAPH_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
GRAPH_GATEWAY=https://gateway.thegraph.com/api


# ─────────────────────────────────────────────────────────────────────────────
# Uniswap — Trading API (executable quote for the gated swap)
# ─────────────────────────────────────────────────────────────────────────────
# Developer Platform key. REQUIRED for the $7k API Integration track — that
# track qualifies on "a valid API key from the Uniswap Developer Platform".
# Sent as the `x-api-key` header. There is no unauthenticated quote endpoint.
UNISWAP_API_KEY=
UNISWAP_API_BASE=https://trade-api.gateway.uniswap.org/v1

# Fallback path only, if the Trading API is unreachable. The QuoterV2 contract
# is non-view by design and reverts to return its data — it MUST be invoked as
# a static call. Skipping that is the most common way to lose an hour here.
ETH_RPC_URL=
UNISWAP_QUOTER_V2=0x61fFE014bA17989E743c5F6cB21bF9697530B21e


# ─────────────────────────────────────────────────────────────────────────────
# 0G Compute — verifiable inference (the subject agent runs here)
# ─────────────────────────────────────────────────────────────────────────────
# TARGET MAINNET — REVISED 2026-07-26 (research D10). Testnet's only chat
# model, qwen2.5-omni, is DETERMINISTIC on our production prompt: 32/32
# identical responses across every temperature/top_p/penalty combination
# tried. A Claude-tier model (cross-checked via local CLI) shows the real
# sampling variance the confidence-interval design requires. Mainnet has
# 22 chat models incl. claude-opus-4-8; testnet's auth/endpoint/parsing
# were separately confirmed working (O2) — only the model choice changes.
ZG_RPC_URL=https://evmrpc.0g.ai
ZG_CHAIN_ID=16661

# Router path (preferred — OpenAI-compatible, keeps the stack in Python).
# Create the key at https://pc.0g.ai (mainnet portal) after depositing.
ZG_API_KEY=
ZG_API_BASE=https://router-api.0g.ai/v1

# SUBJECT MODEL, resolved 2026-07-26 after testing four candidates on mainnet:
#
#   claude-sonnet-5/opus-4-8/fable-5, gpt-5.6-luna/sol/terra
#     -> all share ONE provider (0x1F444c8A8D0b8e99A50e9f165806d28B01916E04)
#        that is_healthy:false in /v1/providers and returns BALANCE_INSUFFICIENT
#        no matter how the ledger/provider sub-account is funded. This looks
#        like a broken deployment on 0G's side, not a client-side funding
#        mistake -- confirmed via both the shared router AND that provider's
#        own dedicated satellite endpoint (see below). Do not sink more time
#        re-funding this provider; pick a different model instead.
#   glm-5.2 (healthy provider, e.g. 0x7DCFe6AEa70350C2090041524c9B4A9262DCe87D)
#     -> call succeeds and carries TEE attestation (TeeML/TDX), but it is a
#        reasoning model that burns its ENTIRE max_tokens budget on hidden
#        reasoning_content and never emits a final answer (finish_reason:
#        "length" at max_tokens=150, 2000, AND 4000 -- reasoning_tokens always
#        equals max_tokens exactly). reasoning_effort/thinking.disabled/
#        chat_template_kwargs are all listed as supported_parameters but NONE
#        of them actually stop the reasoning (router doesn't forward them --
#        same pattern as qwen2.5-omni ignoring temperature on testnet).
#   deepseek-v4-flash  <- WORKS, this is the default below.
#     -> also a reasoning model, but its enable_thinking=false flag IS
#        honored (finish_reason flips from "length" to "stop", verified by
#        direct test). 3 healthy providers. Sweep result (n=3, temp=1.0):
#        mean=0.45, sd=0.05, 6.4s total -- real variance, well inside the
#        45s/reps=3 budget (SC-002).
#
# A distinct, unrelated failure mode hit along the way, worth knowing about:
# some API keys created via the portal's "Advanced" per-provider funding flow
# are scoped to ONE provider's own satellite endpoint (e.g.
# https://<name>.integratenetwork.work/v1/proxy/messages, a third-party
# gateway in front of 0G -- note the different path and app-scoped
# "app-sk-<base64(message:signature)>" auth) and get a plain 401 on the
# shared router. Use a general-purpose key from the main (non-Advanced)
# "Create key" flow for ZG_API_BASE=router-api.0g.ai.
#
# Re-check /v1/providers' is_healthy field and re-run scripts/probe_0g.py's
# variance sweep before trusting any new model choice (research D10).
ZG_MODEL=deepseek-v4-flash

# Testnet is still fine for everything EXCEPT the subject model — kept
# here for reference / fallback smoke-testing only:
# ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# ZG_CHAIN_ID=16602
# ZG_API_BASE=https://router-api-testnet.integratenetwork.work/v1

# Only needed for the direct-SDK path, if the Router turns out not to expose a
# per-response attestation signature (research O1). NEVER commit a real value.
# ZG_PRIVATE_KEY=

# Public address — used only for balance checks. Safe to share.
ZG_ADDRESS=


# ─────────────────────────────────────────────────────────────────────────────
# Behaviour
# ─────────────────────────────────────────────────────────────────────────────
# Repetitions per isolated context.
#   gating  : 3  (minimum that permits a variance estimate; below this the
#                 system returns INSUFFICIENT_SAMPLES and renders no verdict)
#   calibrate: 9–15
COHESION_DEFAULT_REPS=3
COHESION_CALIBRATE_REPS=12

# Confidence for both the interval and the baseline drift test.
COHESION_CONFIDENCE=0.95

# Abort if the three probe legs drift out of mutual consistency by more than
# this. Certifies the cycle is currently arbitrage-tight (FR-003).
COHESION_PRODUCT_TOLERANCE=0.01

# Inference provider: zg | local
# `local` is a disclosed fallback that carries NO attestation. If you run it,
# say so plainly in the demo — never let it imply verified provenance.
COHESION_PROVIDER=zg
